{
	"name": "wixibot",
	"displayName": "WixiBot",
	"description": "WixiLand's Discord Application",
	"author": "Wixonic <contact@wixonic.fr> (https://wixonic.fr)",
	"version": "2.0.0.α.3",
	"license": "Wixonic Non-Commercial License",
	"repository": "github:Wixonic/WixiBot",
	"exports": "./src/main.ts",
	"tasks": {
		"start": "deno run --allow-all src/main.ts",
		"deploy": "deno run --allow-all src/deploy.ts",
		"dev:start": "CLIENT=dev deno run --allow-all src/main.ts",
		"dev:deploy": "CLIENT=dev deno run --allow-all src/deploy.ts"
	},
	"imports": {
		"discord.js": "npm:discord.js@14.26.2",
		"@lmstudio/sdk": "npm:@lmstudio/sdk@1.5.0",
		"@google/genai": "npm:@google/genai@2.6.0",
		"std/": "https://deno.land/std@0.203.0/"
	},
	"compilerOptions": {
		"strict": true
	},
	"unstable": [
		"cron"
	]
}